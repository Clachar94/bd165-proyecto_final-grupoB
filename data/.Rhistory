# 1. Paquetes necesarios
#install.packages(c("tidyverse", "cluster", "factoextra"))
library(tidyverse)
library(cluster)     # pam()
library(factoextra)  # fviz_cluster(), fviz_nbclust()
# 2. Cargar los datos
datos <- Churn_Modelling
