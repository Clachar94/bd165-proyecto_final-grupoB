"trafico_web", "dias_promocion", "ventas")]
# Matriz de correlaciones redondeada a 3 decimales
matriz_cor <- round(cor(num), 3)
matriz_cor
# Visualización de relaciones entre variables
# Si no tiene instalado GGally, ejecutar una vez:
# install.packages("GGally")
library(GGally)
ggpairs(num)
# Modelo inicial con las cuatro variables independientes
modelo_completo <- lm(ventas ~ gasto_publicidad + num_vendedores +
trafico_web + dias_promocion,
data = Datos)
# Resumen del modelo completo
summary(modelo_completo)
# Cálculo del Factor de Inflación de la Varianza
# Si no tiene instalado car, ejecutar una vez:
# install.packages("car")
library(car)
vif(modelo_completo)
# Modelo final propuesto
modelo_final <- lm(ventas ~ gasto_publicidad + num_vendedores,
data = Datos)
# Resumen del modelo final
summary(modelo_final)
# Comparación por AIC y BIC
AIC(modelo_completo, modelo_final)
BIC(modelo_completo, modelo_final)
# Verificación global de supuestos
# Si no tiene instalado gvlma, ejecutar una vez:
# install.packages("gvlma")
library(gvlma)
summary(gvlma(modelo_final))
# Gráficos diagnósticos del modelo final
par(mfrow = c(2, 2))
plot(modelo_final)
par(mfrow = c(1, 1))
shapiro.test(residuals(modelo_final))
# Si no tiene instalado lmtest, ejecutar una vez:
# install.packages("lmtest")
library(lmtest)
bptest(modelo_final)
# Prueba Durbin-Watson
car::durbinWatsonTest(modelo_final)
# Nueva observación con las mismas variables del modelo final
nueva_tienda <- data.frame(
gasto_publicidad = 60,
num_vendedores   = 8
)
# Predicción puntual
predict(modelo_final, newdata = nueva_tienda)
# Intervalo de predicción
predict(modelo_final, newdata = nueva_tienda, interval = "prediction")
