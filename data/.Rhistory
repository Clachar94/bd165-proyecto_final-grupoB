knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE, fig.align = "center")
# Se carga el archivo de datos
Datos <- read.csv("ventas_tiendas.csv")
# Se revisa la estructura de la tabla
str(Datos)
# Se revisa un resumen general de cada variable
summary(Datos)
# Se verifica si existen valores faltantes
colSums(is.na(Datos))
# Se seleccionan solo las variables numéricas importantes para el análisis
num <- Datos[, c("gasto_publicidad", "num_vendedores",
"trafico_web", "dias_promocion", "ventas")]
# Se calcula la matriz de correlaciones
round(cor(num), 3)
# Gráfico visual de relaciones entre variables
library(GGally)
ggpairs(num)
# Modelo con todas las variables independientes
modelo_completo <- lm(ventas ~ gasto_publicidad + num_vendedores +
trafico_web + dias_promocion,
data = Datos)
summary(modelo_completo)
# Se calcula el VIF para revisar multicolinealidad
library(car)
vif(modelo_completo)
# Modelo reducido elegido
modelo_final <- lm(ventas ~ gasto_publicidad + num_vendedores,
data = Datos)
summary(modelo_final)
# Se comparan los modelos con AIC y BIC
AIC(modelo_completo, modelo_final)
BIC(modelo_completo, modelo_final)
# Revisión general de supuestos del modelo
library(gvlma)
summary(gvlma(modelo_final))
# Gráficos diagnósticos del modelo
par(mfrow = c(2, 2))
plot(modelo_final)
par(mfrow = c(1, 1))
# Prueba de normalidad de residuos
shapiro.test(residuals(modelo_final))
# Prueba de independencia de residuos
car::durbinWatsonTest(modelo_final)
# Datos de la nueva tienda con las variables usadas en el modelo final
nueva_tienda <- data.frame(
gasto_publicidad = 60,
num_vendedores   = 8
)
# Predicción puntual
predict(modelo_final, newdata = nueva_tienda)
# Intervalo de predicción
predict(modelo_final, newdata = nueva_tienda, interval = "prediction")
