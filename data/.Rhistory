set.seed(2025)
#Cantidad de personas en la sala
n<- 23
#sample extrae n cumpleañeros al azar entre los días 1 al 365
#replace = TRUE permite que las personas caigan el mismo día
cumples<- sample(1:365, size =n, replace = TRUE)
#Unique quita los días repetidos. Si quedan MENOS días únicos que personas
#es porque al menos 2 coincideron
hay_coincidencia<- length(unique(cumples))<n
print(hay_coincidencia) #TRUE= hubo coincidencia
